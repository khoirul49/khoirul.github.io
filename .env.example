# Netlify Environment Variables
# Copy to .env.local for local development with netlify dev
# Set these in Netlify Dashboard > Site Settings > Environment Variables

# Required: Google AI Studio API Key
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Model name (default: gemini-flash-latest)
# Contoh: gemini-flash-latest, gemini-2.5-flash
GEMINI_MODEL=gemini-flash-latest

# Opsional (hanya dibaca saat `npm run build`): isi hanya jika frontend di-host terpisah
# dari function. Biarkan kosong di Vercel/Netlify (default: /api/chat, domain yang sama).
# VITE_CHAT_API_URL=https://domain-function-kamu/api/chat

# Opsional: model cadangan (dipisah koma) bila model utama sibuk/limit
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash

# Opsional: tampilkan penyebab error di chat saat debugging (matikan setelah selesai)
# CHAT_DEBUG=1
